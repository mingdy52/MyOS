# 이 파일을 복사해 .env 로 만들고 값을 채우세요. (.env 는 커밋되지 않습니다)
#   cp .env.example .env

# Anthropic API 키 (비서·리포트·포트폴리오 생성에 사용)
ANTHROPIC_API_KEY="sk-ant-..."

# 노션 통합(integration) 토큰
NOTION_API_KEY="ntn_..."

# 모든 DB가 들어있는 부모 페이지의 id.
# 앱이 시작할 때 이 페이지를 훑어 안의 DB들(dataSourceId·컬럼)을 자동으로 발견합니다.
# → DB별 id를 따로 적을 필요가 없습니다. 새 DB는 이 페이지 안에 만들고 REPL에서 `refresh` 하면 됩니다.
# (통합을 이 페이지에 '연결'해 두어야 발견됩니다.)
NOTION_DATA_PAGE_ID="페이지 id (하이픈 없는 32자리)"
